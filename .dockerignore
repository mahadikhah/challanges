# Build context exclusions.
#
# This is a correctness file, not just a speed one. The Dockerfile does
# `COPY . .` into the vendor stage, so anything left in here would land on top
# of what the build itself produced. Three entries below are load-bearing:
#
#   vendor/       — a host install (with dev deps, wrong PHP version) would
#                   overwrite the image's --no-dev composer install.
#   node_modules/ — host-built native binaries (lightningcss, rollup, tailwind
#                   oxide) are platform-specific and would break `npm ci`.
#   .env          — would bake developer secrets and APP_ENV=local into a
#                   published image. Environment comes from compose at runtime.

.git
.gitignore
.gitattributes

vendor
node_modules

.env
.env.*
!.env.example

# Generated at build time by the Wayfinder Vite plugin; stale host copies
# would shadow the freshly generated helpers.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Build output — regenerated by `npm run build`.
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr

# Runtime state: never ship a developer's logs, sessions or compiled views.
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/pail
storage/*.key
bootstrap/cache/*.php

# Tests and dev tooling config. Excluding tests/ keeps the runtime image
# smaller; CI runs the suite from a checkout, not from this image.
tests
phpunit.xml
phpstan.neon
pint.json
.phpunit.cache
.phpunit.result.cache
eslint.config.js
.prettierrc
.prettierignore
.editorconfig

# Docs, prompts and agent tooling — none of it is runtime code.
docs
prompts
graphify-out
.github
.ai
.agents
.claude
.codex
.cursor
.junie
AGENTS.md
CLAUDE.md
README.md
README.fa.md
boost.json
opencode.json
.mcp.json

# Deployment definitions. The image must not contain the compose files or
# deploy scripts that orchestrate it.
deploy

# Editor / OS noise
.idea
.vscode
.zed
.fleet
.nova
.DS_Store
