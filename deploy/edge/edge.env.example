# TLS edge configuration — TEMPLATE.
#
#   cp edge.env.example edge.env
#
# Copy to deploy/edge/edge.env on the VM. Unlike the app env files this holds no
# secrets, but it is gitignored all the same so each VM keeps its own domains.

# Both domains must already have A/AAAA records pointing at this VM before the
# edge starts. Caddy requests a certificate on first request to each hostname,
# and ACME's HTTP-01 challenge only succeeds if DNS already resolves here.
PRODUCTION_DOMAIN=example.com
STAGING_DOMAIN=staging.example.com

# Let's Encrypt sends certificate-expiry warnings to this address.
ACME_EMAIL=you@example.com

# Must match EDGE_NETWORK in the app env files. Created by hand:
#   docker network create challenges-edge
EDGE_NETWORK=challenges-edge
