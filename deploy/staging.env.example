# Staging environment — TEMPLATE.
#
# Copy to deploy/staging.env on the VM and fill in. The real file is gitignored:
# it holds the bot tokens and the database password.
#
#   cp deploy/staging.env.example deploy/staging.env
#
# This one file is read twice by deploy.sh, for two different purposes:
#   - as --env-file, to interpolate ${DB_*} into deploy/compose.app.yml
#   - as env_file, to inject everything below into the containers
# So it contains both the compose-level DB_* values and the app's own config.
#
# IMPORTANT — write every value out in full. Unlike Laravel's .env, Docker's
# env_file does NOT expand variables: `MINIAPP_URL=${APP_URL}/miniapp` would
# reach PHP as the literal string "${APP_URL}/miniapp". There is no
# cross-referencing in this file.

# ---------------------------------------------------------------------------
# Deploy-time settings (read by deploy.sh, not by Laravel)
# ---------------------------------------------------------------------------

# The hostname Caddy serves this environment on. deploy.sh probes
# https://<this>/up after switching traffic, and Caddy requests a certificate
# for it. Must already resolve to this VM's public IP.
DEPLOY_DOMAIN=staging.example.com

# The name Caddy proxies to on the shared edge network. Must match the
# `reverse_proxy` target in deploy/edge/Caddyfile. Change both or neither.
EDGE_ALIAS=staging-web

# Queue worker count, passed as `--scale queue=N`. Two is the deliberate
# ceiling from docs/setup-vps.md §5 — sends are staggered one per second, so
# more workers buy little and only add database-queue contention. Staging can
# run one.
QUEUE_WORKERS=1

# ---------------------------------------------------------------------------
# Database (read by BOTH compose and Laravel)
# ---------------------------------------------------------------------------

# `mysql` is the compose service name, not a hostname you control. Do not set
# this to 127.0.0.1: inside the app container that is the app container itself.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=challenges
DB_USERNAME=challenges
DB_PASSWORD=

# Used only to initialise the MySQL container and for maintenance (mysqldump).
# Laravel never connects as root.
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

APP_NAME=Challenges
APP_ENV=staging
# Generate once with:
#   docker run --rm ghcr.io/mahadikhah/challanges/app:latest php artisan key:generate --show
APP_KEY=
APP_DEBUG=false

# Must be the public HTTPS URL. `telegram:set-webhook` builds the webhook URL
# from this and refuses anything that is not https://, so a wrong value here
# surfaces as a webhook that cannot be registered.
APP_URL=https://staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ---------------------------------------------------------------------------
# Drivers — database everywhere, by design. No Redis on these hosts.
# ---------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `stderr` puts application logs into `docker compose logs`, which is the only
# log reader guaranteed to exist on a Docker-only VM.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Telegram / Mini App
# ---------------------------------------------------------------------------

# Use a SEPARATE bot from production. Two deployments pointing one bot at two
# webhooks means whichever registered last silently wins.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random opaque strings — the path secret and the header secret are distinct.
#   docker run --rm ghcr.io/mahadikhah/challanges/app:latest php -r 'echo bin2hex(random_bytes(24));'
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_HEADER_SECRET=
TELEGRAM_REQUIRED_CHANNEL=
MINIAPP_URL=https://staging.example.com/miniapp

# ---------------------------------------------------------------------------
# Bale
# ---------------------------------------------------------------------------

BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_WEBHOOK_SECRET=
BALE_REQUIRED_CHANNEL=
BALE_PROVIDER_TOKEN=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=Challenges

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# External dead-man's-switch (healthchecks.io or similar). Unset = feature off.
# It is the only thing that can detect the scheduler dying outright.
HEALTHCHECK_PING_URL=

# Note: VITE_* variables are deliberately absent. Vite inlines them into the JS
# bundle at build time, so setting them here would have no effect — they are
# build args in .github/workflows/deploy.yml instead.
